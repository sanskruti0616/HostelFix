# =========================================================
# HOSTELFIX BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# =========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas Connection
# Replace with your MongoDB Atlas connection string from Database Deployments -> Connect
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/hostelfix?retryWrites=true&w=majority
MONGODB_DATABASE=hostelfix

# JWT Session Security
JWT_SECRET=replace_with_a_cryptographically_secure_random_secret_in_production
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 / Firebase Authentication
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Optional: restrict sign-in to institutional email domain (e.g. "college.edu")
ALLOWED_EMAIL_DOMAIN=

# Cloudinary Cloud Object Storage (for complaint & resolution photographs)
# Obtain credentials from Cloudinary Console -> Settings -> Access Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini Vision / AI Verification Provider
# Obtain API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
AI_PROVIDER_API_KEY=

# Development Utilities
# Set to "false" in production to disable dev mock login switcher
ALLOW_DEV_LOGIN=true
